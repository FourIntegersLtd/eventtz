# SEC-009: keep secrets, local state and cruft out of the build context so they
# never reach the image or a build cache. The context is `COPY . .`'d wholesale.
.git
.venv
__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache

# Secrets and local environment
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key

# Local tooling and artefacts not needed at runtime
docker-compose.yml
docker-compose.*.yml
*.md
docs
tests
htmlcov
.coverage
coverage.xml
logs
*.log
.DS_Store
