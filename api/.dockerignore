# SEC-009: keep secrets, local state and cruft out of the build context so they
# never reach the image or a build cache. The Dockerfile does `COPY . .`.
# The image needs app/, alembic/ (with its .sql files) and alembic.ini: the
# pre-deploy command migrates from inside it. Email templates live under app/.

# Secrets
.env
.env.*
!.env.example
**/*serviceAccount*.json
**/*service-account*.json
**/*.pem
**/*.key

# Build files themselves
Dockerfile
.dockerignore

# Local tooling, tests, docs and artefacts not needed at runtime
.git
.gitignore
.venv
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
.import_linter_cache
docker-compose.yml
docker-compose.*.yml
Makefile
openapi*.json
**/*.md
docs
tests
scripts
evals
htmlcov
.coverage
coverage.xml
logs
**/*.log
**/.DS_Store
