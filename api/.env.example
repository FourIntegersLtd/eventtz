# Copy to api/.env. Every value below has a working local default except the
# provider keys; staging and production must set the REQUIRED ones.
APP_ENV=local                  # local | test | staging | production

# Postgres (REQUIRED when deployed). Railway hands out postgres://…; any form works.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/eventtz
DATABASE_POOL_SIZE=10
DATABASE_ECHO=false

# Redis: rate limits and live-update fan-out. Optional; off means limits allow
# everything and live updates stay in one process.
REDIS_URL=redis://localhost:6381/0
REDIS_DISABLED=false
# Proxies in front of the API that append to X-Forwarded-For (Railway: 1).
TRUSTED_PROXY_HOPS=1

# Sign-in tokens. JWT_SECRET is REQUIRED when deployed, 32+ characters.
JWT_SECRET=
JWT_ISSUER=eventtz
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
STREAM_TICKET_TTL_SECONDS=60

# Background worker (`make worker`).
WORKER_CONCURRENCY=4
WORKER_FETCH_JOB_POLLING_SECONDS=5

CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000
# Where links in emails point (REQUIRED when deployed).
FRONTEND_URL=http://localhost:3001
LOG_LEVEL=INFO
SENTRY_DSN=
# Comma-separated fallback for admins whose users.admin_role is not set.
SUPER_ADMIN_EMAILS=
# Empty switches the help assistant off (503) and files contact messages under "Other".
OPENAI_API_KEY=
# Empty logs and skips every email (REQUIRED when deployed).
RESEND_API_KEY=
# Comma-separated staff inboxes for ops alerts. Production lists every on-call inbox.
ADMIN_ALERT_EMAILS=hello@eventtz.com
# Cursor automation for bug/booking/payment contact messages. Empty = off.
CURSOR_AUTOMATION_WEBHOOK_URL=
CURSOR_AUTOMATION_WEBHOOK_SECRET=

# S3 uploads (empty keys switch uploads off)
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=eventtz
AWS_REGION=eu-west-2
MEDIA_MAX_FILE_UPLOAD_BYTES=50000000
