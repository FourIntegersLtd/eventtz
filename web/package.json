{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001 --webpack",
    "build": "next build --webpack",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "types": "tsc --noEmit",
    "test": "node --import ./scripts/register-test-loader.mjs --test \"src/**/*.test.ts\"",
    "api:types": "openapi-typescript ../api/openapi.json -o src/foundation/platform-client/schema.d.ts",
    "ci": "npm run types && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.5",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "typescript-eslint": "^8.46.0"
  }
}
