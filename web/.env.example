# FastAPI origin for Next.js rewrites (local). Do not set NEXT_PUBLIC_API_URL in production.
BACKEND_URL=http://localhost:8001

# Mixpanel — leave empty to disable locally
NEXT_PUBLIC_MIXPANEL_TOKEN=
# EU projects must set this and restart `npm run dev`
# NEXT_PUBLIC_MIXPANEL_API_HOST=https://api-eu.mixpanel.com

# Sentry — leave empty to disable (no-op). Browser + Next server/edge.
# Project: four-integers-ltd-09 / eventtz-frontend
NEXT_PUBLIC_SENTRY_DSN=
# Optional server-only fallback if NEXT_PUBLIC_SENTRY_DSN is unset
# SENTRY_DSN=
# Optional source-map upload (CI / Vercel). Never commit the token.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=four-integers-ltd-09
# SENTRY_PROJECT=eventtz-frontend
