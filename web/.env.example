# Copy to .env.local and fill in for your machine. No real secrets here.

# Origin of the platform API (api/). The browser always calls the
# same-origin /api/v1/* path, proxied to this origin by next.config.ts's
# rewrites; server-side code (SSR, route handlers) calls it directly.
# Both default to http://127.0.0.1:8001 when unset.
NEXT_PUBLIC_PLATFORM_API_URL=http://127.0.0.1:8001
PLATFORM_API_URL=http://127.0.0.1:8001

# Sentry DSN. Empty (the default) disables Sentry entirely — see
# foundation/monitoring/sentry.ts.
NEXT_PUBLIC_SENTRY_DSN=

# Mixpanel project token. Empty (the default) disables Mixpanel entirely —
# see foundation/monitoring/mixpanel.ts.
NEXT_PUBLIC_MIXPANEL_TOKEN=
